	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLName</key>
			<string>com.ethenotethan.Portal.url</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>hermesnative</string>
			</array>
		</dict>
	</array>
	<key>NSMicrophoneUsageDescription</key>
	<string>Portal uses the microphone for on-device voice input, so you can speak to the agent. Audio is transcribed locally and never leaves your device.</string>
</dict>
</plist>